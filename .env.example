# Copy to .env (or set as EAS secrets). EXPO_PUBLIC_* values ship in the JS bundle,
# so never put a secret in one.
APP_ENV=development
APP_BUNDLE_ID=com.lumo.app.dev

# Gateway (svc-gateway). Realtime uses the same host over wss.
EXPO_PUBLIC_API_URL=https://api.lumo.app
EXPO_PUBLIC_WEB_DOMAIN=lumo.app

# Google: web client ID (the backend verifies against GOOGLE_CLIENT_IDS) and iOS client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.replace-me

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# X (Twitter) OAuth 2.0 PKCE, public client
EXPO_PUBLIC_X_CLIENT_ID=

# LINE channel ID, Kakao native app key
EXPO_PUBLIC_LINE_CHANNEL_ID=
KAKAO_NATIVE_APP_KEY=

# Firebase config files (download from the Firebase console; not committed)
GOOGLE_SERVICES_JSON=./firebase/google-services.json
GOOGLE_SERVICE_INFO_PLIST=./firebase/GoogleService-Info.plist

EAS_PROJECT_ID=
